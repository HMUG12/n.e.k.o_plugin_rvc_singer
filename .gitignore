# ── vendored PySide6 / shiboken6 ──
pyside6-*/
pyside6_addons-*/
pyside6_essentials-*/
shiboken6-*/
shiboken6/
bin/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# ── Local data / cache ──
data/
*.db
*.db-journal
logs/
.cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Local development ──
# 注意：.vscode/ 不再忽略 — 插件市场 check --release 要求
# .vscode/settings.json 与 .vscode/tasks.json 必须入库（对齐标准模板）
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Archive / historical docs (not for marketplace) ──
archive/

# ── Secrets ──
.env
.env.local
*.pem
*.key

# ── OS / Editor temp ──
*.tmp
*.bak
